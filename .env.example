# .env.example
# Copy to .env to change any of these. Compose reads .env automatically for ${VAR}
# substitution in docker-compose.yml; it never reads THIS file. .env is gitignored.
# Every value below is already the default -- an empty .env changes nothing.
#
# Every comment here is on a line of its own, and yours should be too. Compose strips an
# inline `.env` comment, but `docker run --env-file`, systemd's EnvironmentFile= and
# `set -a; . ./.env` all read the text after the value AS PART OF THE VALUE. On the two
# secret lines below that turns a note into the secret. §15 fault 21.

# DOGFOOD_PORT is the host side only -- the container always listens on 8000.
# DOGFOOD_WORKERS is sized for a laptop, not for throughput.
DOGFOOD_PORT=8000
DOGFOOD_WORKERS=2

# DOGFOOD_DEBUG must never be 1 on anything reachable. DOGFOOD_HOST is your hostname,
# appended to ALLOWED_HOSTS. DOGFOOD_TLS=1 behind a TLS terminator, which gates four
# cookie and redirect settings at once.
DOGFOOD_DEBUG=0
DOGFOOD_HOST=
DOGFOOD_TLS=0

# Leave the first two unset and the portal generates them: the secret key once into the
# state volume, the admin password on first boot, printed once. Set them only if you need
# a known value. An unset DOGFOOD_ADMIN_EMAIL means admin@localhost, which Django's
# validator allows.
# PLACEHOLDER-NOT-A-REAL-VALUE is what a committed secret looks like -- a marker string, not a
# default any setting in src/ actually uses.
DJANGO_SECRET_KEY=
DOGFOOD_ADMIN_PASSWORD=
DOGFOOD_ADMIN_EMAIL=

POSTGRES_DB=dogfood
POSTGRES_USER=dogfood
POSTGRES_PASSWORD=dogfood-local-only-change-me
